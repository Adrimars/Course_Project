# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/innovation_portal"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Secret key — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-at-least-32-characters-long"

# ─── File Uploads ────────────────────────────────────────────────────────────
# Directory for storing uploaded attachments (relative to project root or absolute)
# This directory must NOT be inside public/ to prevent direct access
UPLOAD_DIR="./uploads"
