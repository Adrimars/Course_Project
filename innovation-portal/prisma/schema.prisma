// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  INSPECTOR
  ADMIN
}

enum IdeaStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  INSPECTING
}

enum NoteType {
  PERSONAL
  COLLABORATIVE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum StageDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum NotificationType {
  STATUS_CHANGE
  ASSIGNMENT
  JOIN_REQUEST
  SCORE_RECEIVED
  FEEDBACK
  SYSTEM
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdeaCategory {
  TECHNOLOGY
  PROCESS
  PRODUCT
  COST_SAVING
  CUSTOMER_EXPERIENCE
  OTHER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  ideas         Idea[]          @relation("submitter")
  statusChanges StatusHistory[] @relation("admin")
  notes         Note[]
  assignedTo    Assignment[]    @relation("assignee")
  assignedBy    Assignment[]    @relation("assigner")
  joinRequests  JoinRequest[]

  // Phase 5: Multi-stage review relations
  stageReviewing  ReviewStage[] @relation("stageReviewer")
  stageReviewsBy  StageReview[] @relation("stageReviewAuthor")

  // Phase 7: Notifications + Scoring
  notifications Notification[]
  ideaScores    IdeaScore[]    @relation("scorer")

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Idea {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(200)
  description String       @db.VarChar(5000)
  category    IdeaCategory
  status      IdeaStatus   @default(SUBMITTED)
  visibility  Visibility   @default(PUBLIC)
  metadata          Json?        // Phase 2: category-specific structured fields
  videoLinks        Json?        // Phase 3: array of {url, platform, title} video link objects
  submitterId       String?
  pipelineId        String?      // Phase 5: assigned review pipeline
  currentStageOrder Int          @default(1) // Phase 5: current stage in pipeline (1-based)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  submitter     User?           @relation("submitter", fields: [submitterId], references: [id], onDelete: SetNull)
  attachments   Attachment[]    // Phase 3: multiple attachments (was single `attachment?`)
  statusHistory StatusHistory[]
  notes         Note[]
  assignments   Assignment[]
  joinRequests  JoinRequest[]
  pipeline      ReviewPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageReviews  StageReview[]
  scores        IdeaScore[]     // Phase 7: multi-dimension scores

  @@index([status, visibility])
  @@index([submitterId])
  @@map("ideas")
}

model Attachment {
  id           String   @id @default(cuid())
  ideaId       String   // Phase 3: no longer @unique — many per idea
  originalName String
  storagePath  String
  mimeType     String
  size         Int      // bytes
  displayOrder Int      @default(0) // ordering within the idea's gallery
  createdAt    DateTime @default(now())

  // Relations
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model StatusHistory {
  id         String     @id @default(cuid())
  ideaId     String
  adminId    String?
  fromStatus IdeaStatus?
  toStatus   IdeaStatus
  feedback   String?    @db.VarChar(2000)
  createdAt  DateTime   @default(now())

  // Relations
  idea  Idea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  admin User? @relation("admin", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("status_history")
}

model Note {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  content   String   @db.VarChar(5000)
  type      NoteType @default(PERSONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Assignment {
  id         String           @id @default(cuid())
  ideaId     String
  assignerId String
  assigneeId String
  status     AssignmentStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  idea     Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  assigner User @relation("assigner", fields: [assignerId], references: [id])
  assignee User @relation("assignee", fields: [assigneeId], references: [id])

  @@map("assignments")
}

model JoinRequest {
  id        String            @id @default(cuid())
  ideaId    String
  userId    String
  message   String?           @db.VarChar(500)
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId]) // One active request per user per idea
  @@map("join_requests")
}

// ─── Phase 5: Multi-Stage Review Models ─────────────────────────────────────

model ReviewPipeline {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages ReviewStage[]
  ideas  Idea[]

  @@map("review_pipelines")
}

model ReviewStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  stageOrder  Int      // 1-based sequential order
  reviewerId  String?  // assigned reviewer (ADMIN/INSPECTOR user ID)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline     ReviewPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  reviewer     User?          @relation("stageReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  stageReviews StageReview[]

  @@unique([pipelineId, stageOrder])
  @@map("review_stages")
}

model StageReview {
  id         String        @id @default(cuid())
  ideaId     String
  stageId    String
  reviewerId String
  decision   StageDecision
  feedback   String        @db.VarChar(2000)
  createdAt  DateTime      @default(now())

  idea     Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  stage    ReviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  reviewer User        @relation("stageReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("stage_reviews")
}

// ─── Phase 7: Notifications + Scoring Models ─────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(1000)
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model IdeaScore {
  id                String   @id @default(cuid())
  ideaId            String
  scorerId          String
  feasibility       Int      // 1-10
  impact            Int      // 1-10
  novelty           Int      // 1-10
  costEffectiveness Int      // 1-10
  comment           String?  @db.VarChar(2000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  idea   Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  scorer User @relation("scorer", fields: [scorerId], references: [id], onDelete: Cascade)

  @@unique([ideaId, scorerId])
  @@index([ideaId])
  @@map("idea_scores")
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
